{
  "name": "@sg2/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --alias:@sg2/shared=../shared/src/index.ts --outfile=dist/index.js && esbuild scripts/gm.ts --bundle --platform=node --target=node22 --format=esm --packages=external --alias:@sg2/shared=../shared/src/index.ts --outfile=dist/gm.js",
    "start": "tsx src/index.ts",
    "bots": "tsx scripts/bots.ts",
    "smoke": "node scripts/smoke.mjs",
    "gm": "tsx scripts/gm.ts"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.28",
    "@colyseus/schema": "^5.0.47",
    "@colyseus/ws-transport": "^0.18.5",
    "@sg2/shared": "0.1.0",
    "argon2": "^0.45.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
