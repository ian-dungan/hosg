# Copy this file to .env and replace both placeholder values (deploy/README.md shows how).
# The server refuses to start while SG2_JWT_SECRET is the placeholder (it needs 32+ characters).
# .env is never committed.

# Signs login tokens. At least 32 characters: openssl rand -hex 32
SG2_JWT_SECRET=CHANGE-ME

# The database password. Letters and digits only: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE-ME

# The port players connect to on this machine.
SG2_PORT=2570
